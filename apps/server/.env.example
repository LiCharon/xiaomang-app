# ===== Frontend (Vite) =====
# Reverse proxy base for server APIs
# local: /tikhub-proxy
VITE_API_PROXY_BASE=/tikhub-proxy

# ===== Server (Express) =====
PORT=8787

# Temporary direct MongoDB task lookup for the multi-user desktop-pet demo.
# Set these in the local server and Vercel environment; never expose either value to the browser.
MONGODB_URI=
# Optional when the connection string does not include a database name.
MONGODB_DB_NAME=
# Must match JWT_SECRET used by ai-project-assistant-main's server.
JWT_SECRET=
# Optional legacy fallback for manager registration; prefer invite_codes/invitecodes in MongoDB.
MANAGER_INVITE_CODE=
# Generate with: openssl rand -base64 48
TASK_DEMO_SESSION_SECRET=

# ===== Frontend =====
# Only enable during local demo/debugging. Production should show real auth/API errors.
VITE_ENABLE_PREVIEW_TASKS=false
# Optional transition link to the existing manager application.
VITE_MANAGER_APP_URL=

# Tikhub
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_TOKEN=
# 视频号账号解析的已脱敏上游 JSON 诊断日志：仅本地开发默认开启；预发/生产仅设为 true 才开启。
TIKHUB_WECHAT_RESPONSE_LOG=

# ===== Self-hosted Content Agent =====
AGENT_CONTENT_WORKFLOW_ID=7618854964156563519
AGENT_MAX_LINKS_PER_RUN=5
AGENT_REQUEST_TIMEOUT_MS=120000
AGENT_API_RETRY_ATTEMPTS=2
AGENT_API_RETRY_BASE_DELAY_MS=500
AGENT_CREATIVE_RETRY_ATTEMPTS=2
AGENT_CREATIVE_RETRY_BASE_DELAY_MS=1200
# 分类分析 / 黄金三秒这类「一次调用出一份报告」的 Agent 的重试次数与间隔。
AGENT_RETRY_ATTEMPTS=2
AGENT_RETRY_BASE_DELAY_MS=1500
# 重试总预算（毫秒）。必须明显小于 serverless 函数的 maxDuration（120s），
# 否则重试会把函数拖到被平台强杀，连规则兜底的报告都拿不到。
AGENT_RETRY_BUDGET_MS=90000
# 黄金三秒的真实口播转写。
#
# ⚠️ 2026-10-18 连续两次迁移（按顺序）：
# ① 首位：录音文件识别 2.0（doubao-file）→ 流式识别 2.0（doubao-stream，20h 免费额度）；
# ② 链尾兜底：极速版 flash 段（tikhub-music / tikhub-ffmpeg / ffmpeg）→
#    「豆包录音文件识别模型 2.0」（doubao-file，volc.seedasr.auc，只收音频 URL、异步 submit/query）。
# - doubao-stream 会先用本地 ffmpeg 把音频抽成 16k 单声道 PCM，因此**裁剪有效**
#   （head/tail 5 秒真的只转 5 秒）。
# - doubao-file **只接受公网音频 URL**；视频号没有公网 URL，会被跳过（交给链首的 doubao-stream）。
# - 三个 flash provider 的代码保留；要回滚到极速版兜底，把 GOLD_TRANSCRIPT_PROVIDERS 设成下面注释的链。
#
# TRANSCRIPT_PROVIDERS 只是"基础列表"——config.js 的 getTranscriptProviders() 在列表含
# "ffmpeg" 时会把 "tikhub-ffmpeg"/"tikhub-music" 自动 unshift 到链首；但 doubao-stream /
# doubao-file 显式写在链首时保持链首（见 config.js:63-79）。默认列表已不含 flash 段。
#
# 裁剪对 doubao-stream 生效（内部用 ffmpeg 抽 PCM，会传 `-t N` / `-sseof -N`）；
# doubao-file / doubao-video 把整段音频交给服务端，不吃裁剪（只影响兜底路径）。
GOLD_TRANSCRIPT_CLIP_SECONDS=5
# 黄金三秒专用的 provider 顺序：
#   流式 2.0（免费额度 + 支持裁剪）→ 视频理解 → 录音文件识别 2.0（公网 URL 兜底）。
# 回滚到「极速版 flash」兜底：
#   GOLD_TRANSCRIPT_PROVIDERS=doubao-stream,doubao-video,tikhub-music,tikhub-ffmpeg,ffmpeg
# 完全回到 2026-10-18 之前（录音文件识别 2.0 首位）：
#   GOLD_TRANSCRIPT_PROVIDERS=doubao-file,doubao-video,doubao-stream
GOLD_TRANSCRIPT_PROVIDERS=doubao-stream,doubao-video,doubao-file
# 设为 false 可整体关掉转写，回到纯发布文案的行为。
GOLD_TRANSCRIPT_ENABLED=true
# 转写覆盖多少条 —— 与分析样本数（60）保持一致，否则部分大类只能靠发布文案推断。
GOLD_TRANSCRIPT_LIMIT=60
# 每个请求处理几条。裁剪后单条 ~1.7s，30 条约 17s（并发 3），240s 预算远远用不完，
# 所以 60 条只需 2 轮。单条变慢时预算守卫会提前收尾，前端会接着驱动下一批。
GOLD_TRANSCRIPT_BATCH_SIZE=30
GOLD_TRANSCRIPT_CONCURRENCY=3
# TikHub 解析的预取宽度（与转写并发解耦）。解析 3.4~4.7s/条，比裁剪后的转写还慢，
# 所以给它更宽的通道提前跑。设 0 退回「解析与转写串行」的老行为。
GOLD_TRANSCRIPT_RESOLVE_CONCURRENCY=8
# 单批预算，必须明显小于该端点的 maxDuration（vercel.json 里是 300s）
GOLD_TRANSCRIPT_BUDGET_MS=240000
# TikHub 解析结果缓存 TTL（毫秒）。2.2 黄金三秒与 2.3 结尾钩子跑**同一批视频的同一个
# link**：转写片段不同（head / tail）不能共用，但「视频在哪、直链是什么」是纯重复劳动。
# 解析实测 3.4~4.7s/条，比裁剪后的转写（~1.7s）还贵，所以缓存它同时省时间和额度；
# 顺带把 tikhub-music 快路径要用的 musicUrl 一起复用。
# 比转写缓存（1 小时）短，因为 CDN 直链会过期，拿到过期直链会让下载 403/404。
# 设 0 关闭缓存，回到「每次都重新解析」的旧行为。
AGENT_RESOLVE_CACHE_TTL_MS=1800000
# 解析缓存的条目上限（超出按插入顺序丢最旧的），防止长驻进程无限增长。
AGENT_RESOLVE_CACHE_MAX_ENTRIES=500
# 对标视频「高赞评论」抓取（TikHub 付费接口，只支持抖音）。
# 抓过的视频永久缓存（失败也缓存失败标记），同一个视频一个项目经理只付一次钱；
# 失败也算「已尝试」，否则前端分批循环会对着同一个坏视频无限重抓。
# 每个请求处理几个视频 / 每个视频按点赞保留多少条 / 并发数 /
# 单批预算（必须明显小于该端点的 maxDuration 300s）。
BENCHMARK_COMMENT_BATCH_SIZE=10
BENCHMARK_COMMENT_LIMIT_PER_VIDEO=30
BENCHMARK_COMMENT_CONCURRENCY=4
BENCHMARK_COMMENT_BUDGET_MS=240000

# 抖音粉丝画像（模块 1 用户画像的真实数据源，抖音热榜接口）。
# ⚠️ 一次调用只能拿一个维度，一个账号要 8 次 GET；账号级缓存默认 7 天，
# 同一个账号在这个期限内只付一次钱。设 0 表示每次都重抓。
BENCHMARK_PORTRAIT_CACHE_DAYS=7
AGENT_VIDEO_REGION=CN
# 全局链（员工二创 / 内容生成）的基础列表。2026-10-18 起默认：
#   doubao-stream（流式识别 2.0 / 20h 免费）→ doubao-file（录音文件识别 2.0 / URL 兜底）→ 视频理解。
# 默认不含极速版 flash；若要回滚/手动启用 flash（tikhub-music / tikhub-ffmpeg / ffmpeg）：
#   TRANSCRIPT_PROVIDERS=ffmpeg,doubao-video
# （注意：列表含 ffmpeg 时，TikHub 两个 flash provider 会被自动 unshift 到链首。）
TRANSCRIPT_PROVIDERS=doubao-stream,doubao-file,doubao-video
TIKHUB_TRANSCRIPT_PROVIDER_ENABLED=true
TIKHUB_MUSIC_PROVIDER_ENABLED=true
TIKHUB_MEDIA_URL_MAX_ATTEMPTS=2
# Optional: proxy only TikTok/TikHub CDN media downloads when the server cannot reach tiktokcdn directly.
# HTTPS_PROXY/HTTP_PROXY/ALL_PROXY are also honored by default.
TIKTOK_MEDIA_PROXY_URL=
MEDIA_USE_ENV_PROXY=true

# Optional: proxy for the cover image gateway (星辰API / xxcapi.com).
# 有些网络里 xxcapi.com 只能经代理访问，不给这个配置项出图会以「fetch failed」失败
# （日志会说明是域名解析失败还是连接被拒）。HTTPS_PROXY/HTTP_PROXY/ALL_PROXY 默认也会认。
# 自检：npm run probe:image --workspace @xiaomang/server
XXCAPI_PROXY_URL=
IMAGE_USE_ENV_PROXY=true

# Doubao flash ASR（同步，客户端上传音频 base64）. New console: DOUBAO_API_KEY only.
DOUBAO_API_KEY=
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
DOUBAO_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash

# ── 豆包录音文件识别模型 2.0（异步：submit 提交 + 轮询 query 取结果）──────────
# 与上面的 flash 是两条独立通道。差别是**本通道只接受音频 URL**（服务端自己去拉），
# 不接受 base64 —— 因此**完全不需要本地 ffmpeg**，把 CDN 上的 mp3/mp4 地址交过去即可。
# 实测：57 秒的视频，submit 660ms + 轮询到结果共约 10 秒（旧 ffmpeg 全量提取约 45 秒）。
# 共用 DOUBAO_API_KEY。2026-10-18 第二次迁移后，本通道作为默认链的 2.0 兜底
# （doubao-stream 失败 → doubao-video → doubao-file）；不再作为首位。
DOUBAO_FILE_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
DOUBAO_FILE_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
# volc.seedasr.auc = 录音文件识别模型 2.0（volc.bigasr.auc = 1.0，历史版本）
DOUBAO_FILE_ASR_RESOURCE_ID=volc.seedasr.auc
# 轮询间隔与总预算。官方口径「任务通常 3 小时内完成」，延迟不可控是这条通道最大风险，
# 所以必须有预算：超时就当这个 provider 失败，由 provider 链回退，绝不让一条视频把整批挂死。
DOUBAO_FILE_ASR_POLL_INTERVAL_MS=2000
DOUBAO_FILE_ASR_BUDGET_MS=120000
# 2026-10-18 迁移说明：以上 DOUBAO_FILE_ASR_* 保留可用，但默认链不再使用（回滚用）。
# 回滚到录音文件识别 2.0：
#   GOLD_TRANSCRIPT_PROVIDERS=doubao-file,doubao-video,tikhub-music,tikhub-ffmpeg,ffmpeg

# ── 豆包流式/实时语音识别 2.0（WebSocket，X-Api-Resource-Id=volc.seedasr.sauc.duration）──
# 用于替代录音文件识别 2.0（Seed）：项目里注册为 provider "doubao-stream"。
# 小时版资源 id 按音频时长扣免费额度/计费；并发版是 volc.seedasr.sauc.concurrent（按并发计费，不推荐）。
DOUBAO_STREAM_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_STREAM_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_STREAM_ASR_BUDGET_MS=120000
DOUBAO_STREAM_ASR_CHUNK_BYTES=6400

# Doubao multimodal fallback. Use your Volc Ark chat-completions-compatible endpoint.
DOUBAO_VIDEO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_VIDEO_API_KEY=
DOUBAO_VIDEO_MODEL=doubao-seed-2-0-mini-260428
DOUBAO_VIDEO_AUTH_HEADER=Authorization

# 发布仓 3.1「封面」的出图能力（星辰API / xxcapi.com，OpenAI 兼容协议）。
# ⚠️ 两套变量名都认（代码里 `pickEnv` 两个都读）——历史上代码只读 XXCAPI_、而部署按中文名配了
#    XINGCHEN_，导致出图永远回 501 且报「未配置出图密钥」，排查方向完全错。
#    新配建议用 XINGCHEN_*（与「星辰」对应），两套填一个即可。
XINGCHEN_API_KEY=
# XXCAPI_API_KEY=
# XINGCHEN_BASE_URL=https://xxcapi.com
# XINGCHEN_IMAGE_MODEL=gpt-image-2.5-sunburst
# XINGCHEN_TIMEOUT_MS=180000

# DeepSeek creative agents
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=393216

# Feishu export. Keep secrets in local/Vercel env only; never commit real values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional. Empty means create docx in root directory. When using tenant_access_token, the app must have permission to the folder.
FEISHU_FOLDER_TOKEN=
# Optional. Set to your tenant domain for nicer returned links, for example https://your-company.feishu.cn
FEISHU_DOC_BASE_URL=https://feishu.cn
# Optional fallback. Recommended production flow is user-provided Bitable URL in the final editor.
# Set only FEISHU_BITABLE_APP_TOKEN to create task tables inside one fixed Bitable app when no URL is provided.
# Set both values only when every export should append to one fixed existing table.
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# ── ffmpeg 本地音频提取（视频号、以及链上兜底那一路）────────────────────────
# 🔴 FFMPEG_TIMEOUT_MS 是这条链路**唯一的卡死保护**，同时兜住「下载整条视频 + 抽音频」。
#    2026-09-28 实测（本机、真实抖音视频、完整脚本口径）：
#        TikHub 解析  3.6s
#        ffmpeg 提取  25s ~ 86s   ← 波动极大，取决于 CDN 当时的速度
#        Doubao ASR   2.7s
#    所以**不要调低**：调到 45/60 秒会让正常视频直接超时失败，然后回退到下一个
#    provider 再失败一遍 —— 比不调更低效。（这一点我实测验证过，不是推测。）
#
#    ⚠️ 另一个实测更正：耗时**不在编码器**。0.4MB 的音频用 mp3 还是 aac 编码，
#       ASR 都只花 ~2.7s；曾以为换 aac 能快 2.6 倍，复测发现那是 CDN 网速波动造成的
#       假象（同一条视频两次下载 25s vs 86s）。真正的耗时是**下载整条视频**。
FFMPEG_TIMEOUT_MS=90000
# 关掉本地 ffmpeg（视频号会因此无法转写，因为只有它能消费本地解密流）。
FFMPEG_ENABLED=true
# 提取出的音频大小上限；超限直接报错，不截断（截断会产出"看着像音频"的坏数据）。
FFMPEG_AUDIO_MAX_BYTES=25165824
