# 每日 03:00 备份 MongoDB 到 /opt/xiaomang/backups/。
#
# 必须用 compose.server.yml（聚合了 compose.yml + compose.cvm.yml）：
# backup.sh 只接受单个 -f。备份产物为 mongodump 归档 + sha256 校验文件，
# 保留策略（7 天）在 backup.sh 内部执行。
#
# 手工恢复：COMPOSE_FILE=/opt/xiaomang/deploy/compose.server.yml \
#            sh restore.sh /opt/xiaomang/backups/<file>.archive.gz
# ⚠️ restore.sh 只接受**空库**，不会 --drop 覆盖线上库（刻意设计）。
#
# 排查：cat /var/log/xiaomang-backup.log
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 3 * * * root cd /opt/xiaomang/deploy && COMPOSE_FILE=/opt/xiaomang/deploy/compose.server.yml BACKUP_DIR=/opt/xiaomang/backups sh backup.sh >>/var/log/xiaomang-backup.log 2>&1
