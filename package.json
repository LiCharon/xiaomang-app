{
  "name": "ai-project-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI Project Assistant - 智能项目任务管理与桌宠提醒",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "client": "npm run dev --workspace client",
    "client:build": "npm run build --workspace client",
    "server": "npm run start --workspace server",
    "server:dev": "npm run dev --workspace server",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "install-all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["ai", "project-management", "pet", "reminder"],
  "author": "",
  "license": "ISC"
}
